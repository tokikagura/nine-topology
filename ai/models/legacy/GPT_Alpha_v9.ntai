/**
 * NTAI Engine - GPT Alpha v9
 * AI Name: GPT_Alpha_v9
 * Author: OpenAI GPT x Tokikagura
 * Target: Nine Topology v2.7.2
 *
 * v9 changes:
 * - Returns to v7's compact two-ply style after v8 overfit Claude and became too passive.
 * - Models v2.7.2 correctly: any 15-stone trigger is settled by cumulative score.
 * - Keeps red walls conservative; no early wall dump, and each wall must beat a normal turn.
 * - Adds light late-game mobility checks without letting mobility dominate board tactics.
 * - Raises real-point value moderately and sharpens gas-threshold safety.
 * - Penalizes repetitive same-block slide oscillation while preserving tactical captures.
 * - Detects score-based no-legal-place endings in simulated continuations.
 */
window.NTAI_Engine = {
  name: "GPT_Alpha_v9",
  author: "OpenAI GPT x Tokikagura",
  _plan: null,
  _lastTurnSeen: 0,
  _recentSlides: [],

  decideNextMove: function (board, gameState) {
    "use strict";

    const engine = this;
    const me = gameState.player;
    const enemy = me === "white" ? "black" : "white";
    const phase = gameState.phase;
    const turnNumber = Number.isFinite(Number(gameState.turnNumber))
      ? Number(gameState.turnNumber)
      : 1;
    const gasPhaseActive = Boolean(gameState.gasPhaseActive);
    const scores = {
      white: Number(gameState.scores && gameState.scores.white) || 0,
      black: Number(gameState.scores && gameState.scores.black) || 0
    };
    const redWallsLeft = Number(gameState.redWallsLeft) || 0;
    const lockedBlocks = new Set(gameState.slideLockedBlocks || []);

    const DIRS = ["up", "down", "left", "right"];
    const CORNER_BLOCKS = [0, 2, 6, 8];
    const BLUE_VALUE = 5;
    const DECISIVE = 15;
    const TURN_LIMIT = 128;
    const WIN_VALUE = 100000000;

    if (turnNumber < engine._lastTurnSeen || (turnNumber === 1 && phase === "setup")) {
      engine._plan = null;
      engine._recentSlides = [];
    }
    engine._lastTurnSeen = turnNumber;

    const otherOf = color => color === "white" ? "black" : "white";
    const cloneBoard = src => src.map(block => block.slice());
    const copyScores = src => ({ white: src.white || 0, black: src.black || 0 });

    const boardKey = src => src
      .map(block => block.map(cell => cell === null ? "." : cell).join(","))
      .join("|");

    const countEmpty = src => {
      let total = 0;
      for (const block of src) {
        for (const cell of block) if (cell === null) total++;
      }
      return total;
    };

    const countType = (src, type) => {
      let total = 0;
      for (const block of src) {
        for (const cell of block) if (cell === type) total++;
      }
      return total;
    };

    const toGrid = src => {
      const grid = Array.from({ length: 9 }, () => Array(9).fill(null));
      for (let b = 0; b < 9; b++) {
        for (let c = 0; c < 9; c++) {
          const r = Math.floor(b / 3) * 3 + Math.floor(c / 3);
          const col = (b % 3) * 3 + (c % 3);
          grid[r][col] = src[b][c];
        }
      }
      return grid;
    };

    const fromGrid = grid => {
      const out = Array.from({ length: 9 }, () => Array(9).fill(null));
      for (let r = 0; r < 9; r++) {
        for (let col = 0; col < 9; col++) {
          const b = Math.floor(r / 3) * 3 + Math.floor(col / 3);
          const c = (r % 3) * 3 + (col % 3);
          out[b][c] = grid[r][col];
        }
      }
      return out;
    };

    const blockCellToGrid = (b, c) => ({
      r: Math.floor(b / 3) * 3 + Math.floor(c / 3),
      col: (b % 3) * 3 + (c % 3)
    });

    const groupInfo = (grid, sr, sc) => {
      const type = grid[sr][sc];
      if (!type || type === "red" || type === "neutral" || type === "blue-reserved") {
        return { type, stones: [], liberties: 99, libertyCells: [] };
      }

      const seen = Array.from({ length: 9 }, () => Array(9).fill(false));
      const queue = [[sr, sc]];
      const stones = [];
      const liberties = new Set();
      const steps = [[1, 0], [-1, 0], [0, 1], [0, -1]];
      seen[sr][sc] = true;

      for (let qi = 0; qi < queue.length; qi++) {
        const [r, c] = queue[qi];
        stones.push([r, c]);
        for (const [dr, dc] of steps) {
          const nr = r + dr;
          const nc = c + dc;
          if (nr < 0 || nr >= 9 || nc < 0 || nc >= 9) continue;
          const value = grid[nr][nc];
          if (value === null) liberties.add(nr + "," + nc);
          else if (value === type && !seen[nr][nc]) {
            seen[nr][nc] = true;
            queue.push([nr, nc]);
          }
        }
      }

      return {
        type,
        stones,
        liberties: liberties.size,
        libertyCells: Array.from(liberties)
      };
    };

    const detectZeroLibertyGroups = src => {
      const grid = toGrid(src);
      const checked = Array.from({ length: 9 }, () => Array(9).fill(false));
      const groups = [];

      for (let r = 0; r < 9; r++) {
        for (let c = 0; c < 9; c++) {
          const type = grid[r][c];
          if (!["white", "black", "blue"].includes(type) || checked[r][c]) continue;
          const info = groupInfo(grid, r, c);
          for (const [gr, gc] of info.stones) checked[gr][gc] = true;
          if (info.liberties === 0) groups.push(info);
        }
      }
      return { grid, groups };
    };

    const removeGroups = (grid, groups) => {
      for (const group of groups) {
        for (const [r, c] of group.stones) grid[r][c] = null;
      }
    };

    const resolveSlideCaptures = src => {
      const detected = detectZeroLibertyGroups(src);
      const captured = { white: 0, black: 0, blue: 0 };
      for (const group of detected.groups) captured[group.type] += group.stones.length;
      removeGroups(detected.grid, detected.groups);
      return {
        board: fromGrid(detected.grid),
        captured,
        groups: detected.groups
      };
    };

    const resolvePlacementCaptures = (src, player) => {
      const target = otherOf(player);
      const grid = toGrid(src);
      const checked = Array.from({ length: 9 }, () => Array(9).fill(false));
      const groups = [];
      const captured = { white: 0, black: 0, blue: 0 };

      for (let r = 0; r < 9; r++) {
        for (let c = 0; c < 9; c++) {
          const type = grid[r][c];
          if ((type !== target && type !== "blue") || checked[r][c]) continue;
          const info = groupInfo(grid, r, c);
          for (const [gr, gc] of info.stones) checked[gr][gc] = true;
          if (info.liberties === 0) {
            groups.push(info);
            captured[type] += info.stones.length;
          }
        }
      }

      removeGroups(grid, groups);
      return { board: fromGrid(grid), captured, groups };
    };

    const isSuicidePlacement = (src, player, b, c) => {
      if (!src[b] || src[b][c] !== null) return true;
      const next = cloneBoard(src);
      next[b][c] = player;
      const grid = toGrid(next);
      const pos = blockCellToGrid(b, c);
      const target = otherOf(player);
      const steps = [[1, 0], [-1, 0], [0, 1], [0, -1]];

      for (const [dr, dc] of steps) {
        const nr = pos.r + dr;
        const nc = pos.col + dc;
        if (nr < 0 || nr >= 9 || nc < 0 || nc >= 9) continue;
        const type = grid[nr][nc];
        if (type === target || type === "blue") {
          if (groupInfo(grid, nr, nc).liberties === 0) return false;
        }
      }

      return groupInfo(grid, pos.r, pos.col).liberties === 0;
    };

    const countLegalPlacements = (src, player, stopAfter = 82) => {
      let total = 0;
      for (let b = 0; b < 9; b++) {
        for (let c = 0; c < 9; c++) {
          if (src[b][c] !== null) continue;
          if (!isSuicidePlacement(src, player, b, c)) {
            total++;
            if (total >= stopAfter) return total;
          }
        }
      }
      return total;
    };

    const hasLegalPlacement = (src, player) => countLegalPlacements(src, player, 1) > 0;

    const applyGas = src => {
      const grid = toGrid(src);
      const targets = new Map();
      const steps = [[1, 0], [-1, 0], [0, 1], [0, -1]];

      for (let r = 0; r < 9; r++) {
        for (let c = 0; c < 9; c++) {
          if (grid[r][c] !== null) continue;
          for (const [dr, dc] of steps) {
            const nr = r + dr;
            const nc = c + dc;
            if (nr < 0 || nr >= 9 || nc < 0 || nc >= 9) continue;
            const type = grid[nr][nc];
            if (type === "white" || type === "black") {
              targets.set(nr + "," + nc, { r: nr, c: nc, type });
            }
          }
        }
      }

      const losses = { white: 0, black: 0 };
      for (const target of targets.values()) {
        if (grid[target.r][target.c] === target.type) {
          grid[target.r][target.c] = "neutral";
          losses[target.type]++;
        }
      }

      return { board: fromGrid(grid), losses };
    };

    const finishTurnEnvironment = (src, gasActiveBefore) => {
      const activatesNow = !gasActiveBefore && countEmpty(src) <= 10;
      const gasActiveAfter = gasActiveBefore || activatesNow;
      if (!gasActiveAfter) {
        return {
          board: src,
          gasActive: false,
          gasLosses: { white: 0, black: 0 }
        };
      }
      const gas = applyGas(src);
      return {
        board: gas.board,
        gasActive: true,
        gasLosses: gas.losses
      };
    };

    const applyBlueDropIfDue = (src, nextTurn) => {
      if (nextTurn < 5 || countType(src, "blue-reserved") === 0) return src;
      const out = cloneBoard(src);
      for (let b = 0; b < 9; b++) {
        for (let c = 0; c < 9; c++) {
          if (out[b][c] === "blue-reserved") out[b][c] = "blue";
        }
      }
      return out;
    };

    const nextTurnNoLegalTerminal = (src, nextPlayer, nextTurn, projectedScores) => {
      // Mobility is only expensive enough to test near the endgame.
      if (nextTurn > TURN_LIMIT || countEmpty(src) > 16) return null;
      const prepared = applyBlueDropIfDue(src, nextTurn);
      return hasLegalPlacement(prepared, nextPlayer)
        ? null
        : terminalFromNoLegal(projectedScores);
    };

    const addScoreDelta = (base, delta) => ({
      white: (base.white || 0) + (delta.white || 0),
      black: (base.black || 0) + (delta.black || 0)
    });

    const terminalFromScore = (projectedScores, reason) => {
      if (projectedScores.white > projectedScores.black) return { winner: "white", reason };
      if (projectedScores.black > projectedScores.white) return { winner: "black", reason };
      return { winner: "draw", reason };
    };

    const terminalFromCapture = (captured, projectedScores) => {
      const whiteLost = (captured.white || 0) >= DECISIVE;
      const blackLost = (captured.black || 0) >= DECISIVE;
      if (!whiteLost && !blackLost) return null;
      return terminalFromScore(projectedScores, "CAPTURE_15_SCORE");
    };

    const terminalFromTurnLimit = projectedScores =>
      terminalFromScore(projectedScores, "TURN_LIMIT");

    const terminalFromNoLegal = projectedScores =>
      terminalFromScore(projectedScores, "NO_LEGAL_PLACE");

    const makeOutcome = ({
      board: outBoard,
      outScores,
      gasActive,
      gasLosses,
      captured,
      terminal,
      action,
      placementBoard
    }) => ({
      board: outBoard,
      scores: outScores,
      gasActive,
      gasLosses: gasLosses || { white: 0, black: 0 },
      captured: captured || { white: 0, black: 0, blue: 0 },
      terminal: terminal || null,
      action: action || null,
      placementBoard: placementBoard || null
    });

    const slideRaw = (src, b, dir) => {
      if (!src[b]) return null;
      const next = cloneBoard(src);
      const block = next[b];

      if (dir === "right") {
        [block[0], block[1], block[2]] = [block[2], block[0], block[1]];
        [block[3], block[4], block[5]] = [block[5], block[3], block[4]];
        [block[6], block[7], block[8]] = [block[8], block[6], block[7]];
      } else if (dir === "left") {
        [block[0], block[1], block[2]] = [block[1], block[2], block[0]];
        [block[3], block[4], block[5]] = [block[4], block[5], block[3]];
        [block[6], block[7], block[8]] = [block[7], block[8], block[6]];
      } else if (dir === "down") {
        [block[0], block[3], block[6]] = [block[6], block[0], block[3]];
        [block[1], block[4], block[7]] = [block[7], block[1], block[4]];
        [block[2], block[5], block[8]] = [block[8], block[2], block[5]];
      } else if (dir === "up") {
        [block[0], block[3], block[6]] = [block[3], block[6], block[0]];
        [block[1], block[4], block[7]] = [block[4], block[7], block[1]];
        [block[2], block[5], block[8]] = [block[5], block[8], block[2]];
      } else {
        return null;
      }
      return next;
    };

    const simulatePlacement = (src, player, b, c, baseScores, gasActiveBefore, turn) => {
      if (!src[b] || src[b][c] !== null) return { legal: false, reason: "occupied" };
      if (isSuicidePlacement(src, player, b, c)) return { legal: false, reason: "suicide" };

      const placed = cloneBoard(src);
      placed[b][c] = player;
      const captures = resolvePlacementCaptures(placed, player);
      const opponent = otherOf(player);
      const scoreDelta = { white: 0, black: 0 };
      scoreDelta[player] = (captures.captured[opponent] || 0) + (captures.captured.blue || 0) * BLUE_VALUE;
      const projectedScores = addScoreDelta(baseScores, scoreDelta);
      const capturedTotal = (captures.captured[opponent] || 0) + (captures.captured.blue || 0);
      const captureTerminal = terminalFromCapture(captures.captured, projectedScores);

      if (capturedTotal > 0) {
        const env = finishTurnEnvironment(captures.board, gasActiveBefore);
        let terminal = captureTerminal || (turn >= TURN_LIMIT ? terminalFromTurnLimit(projectedScores) : null);
        if (!terminal && turn < TURN_LIMIT) {
          terminal = nextTurnNoLegalTerminal(env.board, opponent, turn + 1, projectedScores);
        }
        return {
          legal: true,
          turnEnded: true,
          board: env.board,
          scores: projectedScores,
          gasActive: env.gasActive,
          gasLosses: env.gasLosses,
          captured: captures.captured,
          terminal,
          placementBoard: captures.board
        };
      }

      const grid = toGrid(captures.board);
      const pos = blockCellToGrid(b, c);
      const ownGroup = grid[pos.r][pos.col] === player
        ? groupInfo(grid, pos.r, pos.col)
        : { stones: [], liberties: 0 };

      return {
        legal: true,
        turnEnded: false,
        board: captures.board,
        scores: projectedScores,
        gasActive: gasActiveBefore,
        gasLosses: { white: 0, black: 0 },
        captured: captures.captured,
        terminal: captureTerminal,
        placementBoard: captures.board,
        ownGroupSize: ownGroup.stones.length,
        ownLiberties: ownGroup.liberties
      };
    };

    const simulateSlide = (src, player, b, dir, baseScores, gasActiveBefore, turn) => {
      const moved = slideRaw(src, b, dir);
      if (!moved) return { legal: false };
      const captures = resolveSlideCaptures(moved);
      const opponent = otherOf(player);
      const scoreDelta = { white: 0, black: 0 };
      scoreDelta[player] = (captures.captured[opponent] || 0) + (captures.captured.blue || 0) * BLUE_VALUE;
      scoreDelta[opponent] = captures.captured[player] || 0;
      const projectedScores = addScoreDelta(baseScores, scoreDelta);
      const env = finishTurnEnvironment(captures.board, gasActiveBefore);
      let terminal = terminalFromCapture(captures.captured, projectedScores)
        || (turn >= TURN_LIMIT ? terminalFromTurnLimit(projectedScores) : null);
      if (!terminal && turn < TURN_LIMIT) {
        terminal = nextTurnNoLegalTerminal(env.board, opponent, turn + 1, projectedScores);
      }

      return makeOutcome({
        board: env.board,
        outScores: projectedScores,
        gasActive: env.gasActive,
        gasLosses: env.gasLosses,
        captured: captures.captured,
        terminal,
        action: { b, dir },
        placementBoard: src
      });
    };

    const simulatePass = (src, player, baseScores, gasActiveBefore, turn) => {
      const env = finishTurnEnvironment(src, gasActiveBefore);
      const projectedScores = copyScores(baseScores);
      let terminal = turn >= TURN_LIMIT ? terminalFromTurnLimit(projectedScores) : null;
      if (!terminal && turn < TURN_LIMIT) {
        terminal = nextTurnNoLegalTerminal(env.board, otherOf(player), turn + 1, projectedScores);
      }
      return makeOutcome({
        board: env.board,
        outScores: projectedScores,
        gasActive: env.gasActive,
        gasLosses: env.gasLosses,
        captured: { white: 0, black: 0, blue: 0 },
        terminal,
        action: { pass: true },
        placementBoard: src
      });
    };

    const summarize = src => {
      const grid = toGrid(src);
      const checked = Array.from({ length: 9 }, () => Array(9).fill(false));
      const summary = {
        white: {
          stones: 0,
          groups: 0,
          minLib: 99,
          largest: 0,
          danger: 0,
          libertyWeight: 0,
          atariStones: 0,
          criticalGroups: 0
        },
        black: {
          stones: 0,
          groups: 0,
          minLib: 99,
          largest: 0,
          danger: 0,
          libertyWeight: 0,
          atariStones: 0,
          criticalGroups: 0
        }
      };

      for (let r = 0; r < 9; r++) {
        for (let c = 0; c < 9; c++) {
          const type = grid[r][c];
          if ((type !== "white" && type !== "black") || checked[r][c]) continue;
          const info = groupInfo(grid, r, c);
          for (const [gr, gc] of info.stones) checked[gr][gc] = true;

          const n = info.stones.length;
          const libs = info.liberties;
          const s = summary[type];
          s.stones += n;
          s.groups++;
          s.minLib = Math.min(s.minLib, libs);
          s.largest = Math.max(s.largest, n);
          s.libertyWeight += Math.min(libs, 8) * Math.sqrt(Math.max(1, n));

          if (libs === 1) {
            s.atariStones += n;
            s.danger += n * n * 5.2 + n * 18;
            if (n >= DECISIVE) s.danger += 20000;
          } else if (libs === 2) {
            s.danger += n * n * 0.92;
            if (n >= 12) s.criticalGroups++;
          } else if (libs === 3 && n >= 12) {
            s.danger += n * 2.1;
          }
        }
      }
      return summary;
    };

    const gasExposure = src => {
      const grid = toGrid(src);
      const exposed = { white: 0, black: 0 };
      const seen = new Set();
      const steps = [[1, 0], [-1, 0], [0, 1], [0, -1]];

      for (let r = 0; r < 9; r++) {
        for (let c = 0; c < 9; c++) {
          if (grid[r][c] !== null) continue;
          for (const [dr, dc] of steps) {
            const nr = r + dr;
            const nc = c + dc;
            if (nr < 0 || nr >= 9 || nc < 0 || nc >= 9) continue;
            const type = grid[nr][nc];
            if (type !== "white" && type !== "black") continue;
            const key = nr + "," + nc;
            if (seen.has(key)) continue;
            seen.add(key);
            exposed[type]++;
          }
        }
      }
      return exposed;
    };

    const blockShapeScore = (src, perspective) => {
      const opponent = otherOf(perspective);
      let score = 0;
      for (let b = 0; b < 9; b++) {
        let own = 0;
        let opp = 0;
        let empty = 0;
        let red = 0;
        let neutral = 0;
        for (const cell of src[b]) {
          if (cell === perspective) own++;
          else if (cell === opponent) opp++;
          else if (cell === null) empty++;
          else if (cell === "red") red++;
          else if (cell === "neutral") neutral++;
        }

        if (own >= 7) score -= 42 + (own - 7) * 34;
        if (own === 9) score -= 180;
        if (opp >= 7 && empty > 0) score += 18;
        if (red > 0 && own > 0) score += red * Math.min(own, 4) * 1.6;
        if (red > 0 && opp > 0) score -= red * Math.min(opp, 4) * 1.1;
        if (neutral >= 5 && own > 0) score -= (neutral - 4) * own * 1.7;
      }
      return score;
    };

    const blueTensionScore = (src, perspective) => {
      const grid = toGrid(src);
      const checked = Array.from({ length: 9 }, () => Array(9).fill(false));
      const opponent = otherOf(perspective);
      let score = 0;
      const steps = [[1, 0], [-1, 0], [0, 1], [0, -1]];

      for (let r = 0; r < 9; r++) {
        for (let c = 0; c < 9; c++) {
          if (grid[r][c] !== "blue" || checked[r][c]) continue;
          const info = groupInfo(grid, r, c);
          for (const [gr, gc] of info.stones) checked[gr][gc] = true;
          let ownContact = 0;
          let enemyContact = 0;
          for (const [br, bc] of info.stones) {
            for (const [dr, dc] of steps) {
              const nr = br + dr;
              const nc = bc + dc;
              if (nr < 0 || nr >= 9 || nc < 0 || nc >= 9) continue;
              if (grid[nr][nc] === perspective) ownContact++;
              else if (grid[nr][nc] === opponent) enemyContact++;
            }
          }
          const urgency = info.liberties <= 1 ? 12 : info.liberties === 2 ? 5 : 1;
          score += (ownContact - enemyContact) * urgency * BLUE_VALUE;
        }
      }
      return score;
    };

    const evaluateBoard = (src, perspective, projectedScores, gasActive, turn) => {
      const opponent = otherOf(perspective);
      const s = summarize(src);
      const mine = s[perspective];
      const theirs = s[opponent];
      const empties = countEmpty(src);
      const progress = Math.min(1, Math.max(0, turn / TURN_LIMIT));
      const pointGap = (projectedScores[perspective] || 0) - (projectedScores[opponent] || 0);
      let score = 0;

      // Points decide all official endings, but v8 made them overpower tactical shape.
      // v9 keeps a firm, moderate weight and becomes score-first only near the limit.
      const pointWeight = turn >= 118 ? 108 : 25 + progress * 38;
      score += pointGap * pointWeight;
      score += (mine.stones - theirs.stones) * (6.4 + progress * 3.4);
      score += mine.libertyWeight * 3.55 - theirs.libertyWeight * 2.95;
      score -= mine.danger * 1.03;
      score += theirs.danger * 0.94;
      score -= mine.atariStones * 17;
      score += theirs.atariStones * 13;
      score -= mine.criticalGroups * 38;
      score += theirs.criticalGroups * 28;

      if (mine.minLib <= 1) score -= 155;
      if (theirs.minLib <= 1) score += 108;
      if (mine.largest >= DECISIVE && mine.minLib <= 2) score -= 310;
      if (theirs.largest >= DECISIVE && theirs.minLib <= 2) score += 220;

      score += blockShapeScore(src, perspective);
      score += blueTensionScore(src, perspective);

      const exposure = gasExposure(src);
      const gasNear = gasActive || empties <= 17;
      if (gasNear) {
        let pressure = gasActive ? 20 : Math.max(5, 19 - empties);
        if (!gasActive && empties <= 12) pressure += 10;
        score -= exposure[perspective] * pressure;
        score += exposure[opponent] * pressure * 0.74;
      } else {
        score += exposure[perspective] * 0.7;
        score -= exposure[opponent] * 0.5;
      }

      if (gasActive) {
        score += (mine.stones - theirs.stones) * 5.2;
        score -= mine.criticalGroups * 55;
        score += theirs.criticalGroups * 38;
        score -= countType(src, "neutral") * 0.12;
      }

      // Legal-placement pressure is real, but only use it when the board is already tight.
      if (empties <= 16) {
        const ownLegal = countLegalPlacements(src, perspective);
        const oppLegal = countLegalPlacements(src, opponent);
        const mobilityWeight = turn >= 108 ? 8 : 4.5;
        score += (ownLegal - oppLegal) * mobilityWeight;
        if (ownLegal <= 2) score -= (3 - ownLegal) * (turn >= 90 ? 230 : 110);
        if (oppLegal <= 2) score += (3 - oppLegal) * (turn >= 90 ? 200 : 95);
      }

      if (countType(src, "blue-reserved") > 0 && turn < 5) {
        const b3 = src[2] || [];
        const flexibility = b3.filter(cell => cell === null || cell === "blue-reserved").length;
        score += flexibility * 0.9;
      }

      return score;
    };

    const evaluateOutcome = (outcome, perspective, turn) => {
      if (outcome.terminal) {
        if (outcome.terminal.winner === "draw") {
          const opponent = otherOf(perspective);
          return ((outcome.scores[perspective] || 0) - (outcome.scores[opponent] || 0)) * 1000;
        }
        const margin = (outcome.scores[perspective] || 0) - (outcome.scores[otherOf(perspective)] || 0);
        return outcome.terminal.winner === perspective
          ? WIN_VALUE + margin * 1000
          : -WIN_VALUE + margin * 1000;
      }
      return evaluateBoard(outcome.board, perspective, outcome.scores, outcome.gasActive, turn);
    };

    const actionTieBreak = action => {
      if (!action) return -10;
      if (action.pass) return 0;
      const centerBias = action.b === 4 ? 0.35 : 0;
      const dirBias = action.dir === "up" ? 0.04 : action.dir === "left" ? 0.03 : action.dir === "down" ? 0.02 : 0.01;
      return centerBias + dirBias - action.b * 0.0001;
    };

    const inverseDir = dir => ({ up: "down", down: "up", left: "right", right: "left" }[dir]);

    const slideHabitPenalty = (action, player, turn) => {
      if (!action || action.pass || player !== me || turn !== turnNumber) return 0;
      const history = engine._recentSlides || [];
      if (!history.length) return 0;
      const last = history[history.length - 1];
      let penalty = 0;
      if (last.b === action.b && inverseDir(last.dir) === action.dir) penalty += 24;
      else if (last.b === action.b && last.dir === action.dir) penalty += 11;
      const sameBlock = history.slice(-4).filter(x => x.b === action.b).length;
      if (sameBlock >= 2) penalty += (sameBlock - 1) * 7;
      return penalty;
    };

    const chooseBestTurnEnd = (placementResult, player, turn, slideLocks) => {
      if (placementResult.turnEnded) {
        return makeOutcome({
          board: placementResult.board,
          outScores: placementResult.scores,
          gasActive: placementResult.gasActive,
          gasLosses: placementResult.gasLosses,
          captured: placementResult.captured,
          terminal: placementResult.terminal,
          action: null,
          placementBoard: placementResult.placementBoard
        });
      }

      let best = simulatePass(
        placementResult.board,
        player,
        placementResult.scores,
        placementResult.gasActive,
        turn
      );
      let bestScore = evaluateOutcome(best, player, turn) + actionTieBreak(best.action)
        - slideHabitPenalty(best.action, player, turn);

      for (let b = 0; b < 9; b++) {
        if (slideLocks.has(b)) continue;
        for (const dir of DIRS) {
          const outcome = simulateSlide(
            placementResult.board,
            player,
            b,
            dir,
            placementResult.scores,
            placementResult.gasActive,
            turn
          );
          if (!outcome.legal && outcome.legal !== undefined) continue;
          const value = evaluateOutcome(outcome, player, turn) + actionTieBreak(outcome.action)
            - slideHabitPenalty(outcome.action, player, turn);
          if (value > bestScore) {
            best = outcome;
            bestScore = value;
          }
        }
      }
      return best;
    };

    const bestSlideFromCurrent = (src, player, baseScores, gasActiveBefore, turn, slideLocks) => {
      const placementStub = {
        turnEnded: false,
        board: src,
        scores: copyScores(baseScores),
        gasActive: gasActiveBefore,
        captured: { white: 0, black: 0, blue: 0 },
        placementBoard: src
      };
      return chooseBestTurnEnd(placementStub, player, turn, slideLocks);
    };

    const quickPlacementValue = (placementResult, player, turn) => {
      const opponent = otherOf(player);
      let value = evaluateBoard(
        placementResult.board,
        player,
        placementResult.scores,
        placementResult.gasActive,
        turn
      );
      value += (placementResult.captured[opponent] || 0) * 110;
      value += (placementResult.captured.blue || 0) * BLUE_VALUE * 120;
      value -= (placementResult.captured[player] || 0) * 140;
      value -= (placementResult.gasLosses[player] || 0) * 75;
      value += (placementResult.gasLosses[opponent] || 0) * 48;
      if (placementResult.terminal) value = evaluateOutcome(makeOutcome({
        board: placementResult.board,
        outScores: placementResult.scores,
        gasActive: placementResult.gasActive,
        gasLosses: placementResult.gasLosses,
        captured: placementResult.captured,
        terminal: placementResult.terminal
      }), player, turn);
      return value;
    };

    const enumerateFullTurnCandidates = (src, player, baseScores, gasActiveBefore, turn, slideLocks) => {
      const candidates = [];
      for (let b = 0; b < 9; b++) {
        for (let c = 0; c < 9; c++) {
          if (src[b][c] !== null) continue;
          const placement = simulatePlacement(src, player, b, c, baseScores, gasActiveBefore, turn);
          if (!placement.legal) continue;
          const outcome = chooseBestTurnEnd(placement, player, turn, slideLocks);
          const value = evaluateOutcome(outcome, player, turn);
          candidates.push({ b, c, placement, outcome, value });
        }
      }
      candidates.sort((a, b) => b.value - a.value || a.b - b.b || a.c - b.c);
      return candidates;
    };

    const chooseOpponentReply = (src, player, baseScores, gasActiveBefore, turn) => {
      const opponent = otherOf(player);
      const preparedBoard = applyBlueDropIfDue(src, turn);
      const prelim = [];

      for (let b = 0; b < 9; b++) {
        for (let c = 0; c < 9; c++) {
          if (preparedBoard[b][c] !== null) continue;
          const placement = simulatePlacement(preparedBoard, opponent, b, c, baseScores, gasActiveBefore, turn);
          if (!placement.legal) continue;
          prelim.push({
            b,
            c,
            placement,
            quick: quickPlacementValue(placement, opponent, turn)
          });
        }
      }

      if (!prelim.length) {
        return makeOutcome({
          board: preparedBoard,
          outScores: copyScores(baseScores),
          gasActive: gasActiveBefore,
          terminal: terminalFromNoLegal(baseScores),
          action: null
        });
      }

      prelim.sort((a, b) => b.quick - a.quick || a.b - b.b || a.c - b.c);
      const empties = countEmpty(preparedBoard);
      const replyCount = empties <= 22 ? 12 : empties <= 45 ? 9 : 7;
      const shortlist = prelim.slice(0, Math.min(replyCount, prelim.length));
      let bestForOpponent = null;
      let bestOpponentValue = -Infinity;

      for (const item of shortlist) {
        const outcome = chooseBestTurnEnd(item.placement, opponent, turn, new Set());
        const value = evaluateOutcome(outcome, opponent, turn);
        if (value > bestOpponentValue) {
          bestOpponentValue = value;
          bestForOpponent = outcome;
        }
      }

      return bestForOpponent;
    };

    const redAppearanceOutcome = (src, owner, b, c, baseScores, gasActiveBefore, turn) => {
      if (!src[b] || (src[b][c] !== null && src[b][c] !== "blue-reserved")) return null;
      const next = cloneBoard(src);
      next[b][c] = "red";
      const captures = resolveSlideCaptures(next);
      const opponent = otherOf(owner);
      const delta = { white: 0, black: 0 };
      delta[owner] = (captures.captured[opponent] || 0) + (captures.captured.blue || 0) * BLUE_VALUE;
      delta[opponent] = captures.captured[owner] || 0;
      const projectedScores = addScoreDelta(baseScores, delta);
      let terminal = terminalFromCapture(captures.captured, projectedScores);
      if (!terminal && turn <= TURN_LIMIT && !hasLegalPlacement(captures.board, owner)) {
        terminal = terminalFromNoLegal(projectedScores);
      }
      return makeOutcome({
        board: captures.board,
        outScores: projectedScores,
        gasActive: gasActiveBefore,
        captured: captures.captured,
        terminal,
        action: { red: true, b, c }
      });
    };

    const redPersistenceFactor = (src, targetBoard, owner, b, c, baseScores, gasActiveBefore, turn) => {
      if (!src[b] || src[b][c] !== null) return 0;
      if (!targetBoard[b] || targetBoard[b][c] !== null) return 0;
      const opponent = otherOf(owner);
      const enemyPlacement = simulatePlacement(targetBoard, opponent, b, c, baseScores, gasActiveBefore, turn + 1);
      if (!enemyPlacement.legal) return 0.96;

      const enemyGain = (enemyPlacement.captured[owner] || 0)
        + (enemyPlacement.captured.blue || 0) * BLUE_VALUE;
      if (enemyPlacement.terminal && enemyPlacement.terminal.winner === opponent) return 0.08;
      if (enemyGain >= 5) return 0.16;
      if (enemyGain > 0) return 0.28;

      const pos = blockCellToGrid(b, c);
      const grid = toGrid(targetBoard);
      const steps = [[1, 0], [-1, 0], [0, 1], [0, -1]];
      let adjacentEnemy = 0;
      let adjacentOwner = 0;
      let adjacentEmpty = 0;
      for (const [dr, dc] of steps) {
        const nr = pos.r + dr;
        const nc = pos.col + dc;
        if (nr < 0 || nr >= 9 || nc < 0 || nc >= 9) continue;
        if (grid[nr][nc] === opponent) adjacentEnemy++;
        else if (grid[nr][nc] === owner) adjacentOwner++;
        else if (grid[nr][nc] === null) adjacentEmpty++;
      }

      let factor = 0.68;
      factor -= adjacentEnemy * 0.10;
      factor -= adjacentOwner * 0.03;
      factor += adjacentEmpty * 0.035;
      return Math.max(0.22, Math.min(0.88, factor));
    };

    const chooseRedDeclaration = (normalBest, src, player, baseScores, gasActiveBefore, turn, wallsLeft) => {
      if (wallsLeft <= 0 || turn < 36 || turn >= 124) return null;

      const noPlaceOutcome = bestSlideFromCurrent(
        src,
        player,
        baseScores,
        gasActiveBefore,
        turn,
        lockedBlocks
      );
      if (noPlaceOutcome.terminal) return null;

      const noPlaceValue = evaluateOutcome(noPlaceOutcome, player, turn);
      let bestRed = null;
      let bestAdjusted = -Infinity;

      for (let b = 0; b < 9; b++) {
        for (let c = 0; c < 9; c++) {
          if (src[b][c] !== null) continue;
          if (!noPlaceOutcome.board[b] || noPlaceOutcome.board[b][c] !== null) continue;

          const wallOutcome = redAppearanceOutcome(
            noPlaceOutcome.board,
            player,
            b,
            c,
            noPlaceOutcome.scores,
            noPlaceOutcome.gasActive,
            turn + 2
          );
          if (!wallOutcome) continue;

          const wallValue = evaluateOutcome(wallOutcome, player, turn + 2);
          const rawGain = wallValue - noPlaceValue;
          const persistence = redPersistenceFactor(
            src,
            noPlaceOutcome.board,
            player,
            b,
            c,
            noPlaceOutcome.scores,
            noPlaceOutcome.gasActive,
            turn
          );

          const capturedOpponent = wallOutcome.captured[otherOf(player)] || 0;
          const capturedSelf = wallOutcome.captured[player] || 0;
          let adjusted = noPlaceValue + rawGain * persistence;
          adjusted += capturedOpponent * 20;
          adjusted -= capturedSelf * 30;
          adjusted -= 15;

          if (wallOutcome.terminal && wallOutcome.terminal.winner === player) adjusted += 3000000 * persistence;
          if (wallOutcome.terminal && wallOutcome.terminal.winner === otherOf(player)) adjusted -= 3000000;

          if (adjusted > bestAdjusted) {
            bestAdjusted = adjusted;
            bestRed = {
              b,
              c,
              adjusted,
              rawGain,
              persistence,
              plannedSlide: noPlaceOutcome.action,
              expectedSlideBoard: noPlaceOutcome.placementBoard
            };
          }
        }
      }

      if (!bestRed) return null;
      const normalValue = normalBest ? normalBest.value : -Infinity;
      const severeNeed = bestRed.rawGain >= 120 || bestRed.adjusted >= normalValue + 35;
      const acceptableTrade = bestRed.adjusted >= normalValue + 12;
      const reliable = bestRed.persistence >= 0.42;
      return (reliable && (severeNeed || acceptableTrade)) ? bestRed : null;
    };

    if (phase === "setup") {
      let best = null;
      let bestScore = -Infinity;
      for (const b of CORNER_BLOCKS) {
        if (board[b].some(cell => cell === me)) continue;
        for (let c = 0; c < 9; c++) {
          if (board[b][c] !== null) continue;
          let value = 0;
          if (c === 4) value += 9;
          if ([0, 2, 6, 8].includes(c)) value += 4;
          if ([1, 3, 5, 7].includes(c)) value += 2;
          if (board[b].some(cell => cell === enemy)) value -= 1.5;
          value -= b * 0.001 + c * 0.0001;
          if (value > bestScore) {
            bestScore = value;
            best = { b, c };
          }
        }
      }
      engine._plan = null;
      return { place: best || { b: 0, c: 0 } };
    }

    if (phase === "slide") {
      if (
        engine._plan &&
        engine._plan.turn === turnNumber &&
        engine._plan.player === me &&
        engine._plan.expectedBoardKey === boardKey(board)
      ) {
        const planned = engine._plan.slide;
        engine._plan = null;
        if (planned && planned.pass === true) {
          return { place: null, slide: { pass: true } };
        }
        if (planned && Number.isInteger(planned.b) && DIRS.includes(planned.dir) && !lockedBlocks.has(planned.b)) {
          engine._recentSlides.push({ b: planned.b, dir: planned.dir });
          if (engine._recentSlides.length > 6) engine._recentSlides.shift();
          return { place: null, slide: { b: planned.b, dir: planned.dir } };
        }
      }

      engine._plan = null;
      const best = bestSlideFromCurrent(board, me, scores, gasPhaseActive, turnNumber, lockedBlocks);
      const chosen = best.action || { pass: true };
      if (!chosen.pass && Number.isInteger(chosen.b) && DIRS.includes(chosen.dir)) {
        engine._recentSlides.push({ b: chosen.b, dir: chosen.dir });
        if (engine._recentSlides.length > 6) engine._recentSlides.shift();
      }
      return { place: null, slide: chosen };
    }

    if (phase === "place") {
      const candidates = enumerateFullTurnCandidates(
        board,
        me,
        scores,
        gasPhaseActive,
        turnNumber,
        lockedBlocks
      );

      if (!candidates.length) {
        engine._plan = null;
        return { place: { b: 0, c: 0, secretRed: false }, slide: null };
      }

      const empties = countEmpty(board);
      const rootCount = empties <= 20 ? 11 : empties <= 45 ? 8 : 6;
      const roots = candidates.slice(0, Math.min(rootCount, candidates.length));

      for (const candidate of roots) {
        if (candidate.outcome.terminal) {
          candidate.searchedValue = candidate.value;
          continue;
        }

        const nextTurn = turnNumber + 1;
        const reply = chooseOpponentReply(
          candidate.outcome.board,
          me,
          candidate.outcome.scores,
          candidate.outcome.gasActive,
          nextTurn
        );
        const replyValue = evaluateOutcome(reply, me, nextTurn);
        const immediateValue = candidate.value;
        const caution = empties <= 20 ? 0.80 : empties <= 40 ? 0.72 : 0.66;
        candidate.searchedValue = immediateValue * (1 - caution) + replyValue * caution;
      }

      for (let i = roots.length; i < candidates.length; i++) {
        candidates[i].searchedValue = candidates[i].value - 250;
      }

      candidates.sort((a, b) =>
        b.searchedValue - a.searchedValue ||
        b.value - a.value ||
        a.b - b.b ||
        a.c - b.c
      );

      const bestNormal = candidates[0];
      const redChoice = chooseRedDeclaration(
        bestNormal,
        board,
        me,
        scores,
        gasPhaseActive,
        turnNumber,
        redWallsLeft
      );

      if (redChoice) {
        engine._plan = {
          turn: turnNumber,
          player: me,
          expectedBoardKey: boardKey(board),
          slide: redChoice.plannedSlide || { pass: true },
          redTarget: { b: redChoice.b, c: redChoice.c }
        };
        return {
          place: { b: redChoice.b, c: redChoice.c, secretRed: true },
          slide: null
        };
      }

      const plannedSlide = bestNormal.outcome.action;
      if (!bestNormal.placement.turnEnded && plannedSlide) {
        engine._plan = {
          turn: turnNumber,
          player: me,
          expectedBoardKey: boardKey(bestNormal.placement.board),
          slide: plannedSlide
        };
      } else {
        engine._plan = null;
      }

      return {
        place: { b: bestNormal.b, c: bestNormal.c, secretRed: false },
        slide: null
      };
    }

    engine._plan = null;
    return { place: null, slide: { pass: true } };
  }
};
