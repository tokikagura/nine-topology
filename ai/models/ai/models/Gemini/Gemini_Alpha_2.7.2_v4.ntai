/**
 * Nine Topology v2.7.2 Engine
 * Engine Name: Gemini_Alpha_v14_v2.7.2_Latest
 * Author: Google / Gemini
 * Description: Fully inherits Gemini_Alpha architecture (TT, 81-Cell Position Weights, Preemption Table, Gas Preview).
 */

(function () {
  const NT_DIRS = ["up", "down", "left", "right"];
  const CORNER_BLOCKS = [0, 2, 6, 8]; // B1, B3, B7, B9
  const TT = new Map(); // 置換表 (Transposition Table)

  // 81マスの位置価値データ (3x3ブロック x 9)
  const POSITION_WEIGHTS = [
    [12, 10, 12, 10, 15, 10, 12, 10, 12], // B1
    [14, 16, 14, 16, 20, 16, 14, 16, 14], // B2
    [12, 10, 12, 10, 15, 10, 12, 10, 12], // B3
    [14, 16, 14, 16, 20, 16, 14, 16, 14], // B4
    [18, 22, 18, 22, 30, 22, 18, 22, 18], // B5 (中央最重要)
    [14, 16, 14, 16, 20, 16, 14, 16, 14], // B6
    [12, 10, 12, 10, 15, 10, 12, 10, 12], // B7
    [14, 16, 14, 16, 20, 16, 14, 16, 14], // B8
    [12, 10, 12, 10, 15, 10, 12, 10, 12]  // B9
  ];

  function cloneBoard(board) {
    return board.map(block => block.slice());
  }

  function boardToGrid(board) {
    const grid = Array.from({ length: 9 }, () => Array(9).fill(null));
    for (let b = 0; b < 9; b++) {
      for (let c = 0; c < 9; c++) {
        const row = Math.floor(b / 3) * 3 + Math.floor(c / 3);
        const col = (b % 3) * 3 + (c % 3);
        grid[row][col] = board[b][c];
      }
    }
    return grid;
  }

  function gridToBoard(grid) {
    const board = Array.from({ length: 9 }, () => Array(9).fill(null));
    for (let row = 0; row < 9; row++) {
      for (let col = 0; col < 9; col++) {
        const b = Math.floor(row / 3) * 3 + Math.floor(col / 3);
        const c = (row % 3) * 3 + (c % 3);
        board[b][c] = grid[row][col];
      }
    }
    return board;
  }

  function getBoardKey(board, player) {
    let key = player + ":";
    for (let b = 0; b < 9; b++) {
      key += board[b].map(v => v === null ? "." : v[0]).join("");
    }
    return key;
  }

  function getGroupInfo(grid, startRow, startCol) {
    const stone = grid[startRow][startCol];
    if (!stone || ["red", "neutral", "blue-reserved"].includes(stone)) {
      return { stone, stones: [], liberties: 99 };
    }

    const visited = Array.from({ length: 9 }, () => Array(9).fill(false));
    const queue = [[startRow, startCol]];
    const stones = [];
    const liberties = new Set();
    const directions = [[1, 0], [-1, 0], [0, 1], [0, -1]];

    visited[startRow][startCol] = true;

    while (queue.length > 0) {
      const [r, c] = queue.shift();
      stones.push({ row: r, col: c });

      for (const [dr, dc] of directions) {
        const nr = r + dr;
        const nc = c + dc;
        if (nr < 0 || nr >= 9 || nc < 0 || nc >= 9) continue;

        const neighbor = grid[nr][nc];
        if (neighbor === null) {
          liberties.add(`${nr},${nc}`);
        } else if (neighbor === stone && !visited[nr][nc]) {
          visited[nr][nc] = true;
          queue.push([nr, nc]);
        }
      }
    }

    return { stone, stones, liberties: liberties.size };
  }

  function resolveCaptures(board) {
    const grid = boardToGrid(board);
    const checked = Array.from({ length: 9 }, () => Array(9).fill(false));
    const captured = { white: 0, black: 0, blue: 0 };
    const capturedGroups = [];

    for (let row = 0; row < 9; row++) {
      for (let col = 0; col < 9; col++) {
        const stone = grid[row][col];
        if (!["white", "black", "blue"].includes(stone) || checked[row][col]) {
          continue;
        }

        const group = getGroupInfo(grid, row, col);
        for (const pos of group.stones) {
          checked[pos.row][pos.col] = true;
        }

        if (group.liberties === 0) {
          captured[stone] = (captured[stone] || 0) + group.stones.length;
          capturedGroups.push(group);
        }
      }
    }

    for (const group of capturedGroups) {
      for (const pos of group.stones) {
        grid[pos.row][pos.col] = null;
      }
    }

    return { board: gridToBoard(grid), captured };
  }

  function slideBlock(board, blockIndex, direction) {
    const next = cloneBoard(board);
    const b = next[blockIndex];
    if (!b || !NT_DIRS.includes(direction)) return null;

    if (direction === "right") {
      next[blockIndex] = [b[2], b[0], b[1], b[5], b[3], b[4], b[8], b[6], b[7]];
    } else if (direction === "left") {
      next[blockIndex] = [b[1], b[2], b[0], b[4], b[5], b[3], b[7], b[8], b[6]];
    } else if (direction === "down") {
      next[blockIndex] = [b[6], b[7], b[8], b[0], b[1], b[2], b[3], b[4], b[5]];
    } else if (direction === "up") {
      next[blockIndex] = [b[3], b[4], b[5], b[6], b[7], b[8], b[0], b[1], b[2]];
    }

    return resolveCaptures(next);
  }

  function simulatePlace(board, player, b, c) {
    if (!board[b] || board[b][c] !== null) {
      return { legal: false, reason: "occupied" };
    }

    const next = cloneBoard(board);
    next[b][c] = player;

    const result = resolveCaptures(next);
    const grid = boardToGrid(result.board);

    const row = Math.floor(b / 3) * 3 + Math.floor(c / 3);
    const col = (b % 3) * 3 + (c % 3);
    const selfGroup = getGroupInfo(grid, row, col);

    const oppColor = player === "white" ? "black" : "white";
    const capturedOpp = result.captured[oppColor] || 0;
    const capturedBlue = result.captured.blue || 0;

    if (selfGroup.liberties === 0 && capturedOpp === 0 && capturedBlue === 0) {
      return { legal: false, reason: "suicide" };
    }

    return { legal: true, board: result.board, captured: result.captured };
  }

  /**
   * 統合評価関数 (81マス位置価値 + Preemption + ガスフェーズ予測)
   */
  function evaluateBoardAdvanced(board, myColor, scheduledReds = [], emptyCount = 81) {
    const oppColor = myColor === "white" ? "black" : "white";
    const grid = boardToGrid(board);
    const checked = Array.from({ length: 9 }, () => Array(9).fill(false));

    let score = 0;

    for (let b = 0; b < 9; b++) {
      for (let c = 0; c < 9; c++) {
        const stone = board[b][c];
        const weight = POSITION_WEIGHTS[b][c];

        if (stone === myColor) {
          score += weight;
        } else if (stone === oppColor) {
          score -= weight;
        }
      }
    }

    for (let r = 0; r < 9; r++) {
      for (let c = 0; c < 9; c++) {
        const stone = grid[r][c];

        if ((stone === myColor || stone === oppColor) && !checked[r][c]) {
          const group = getGroupInfo(grid, r, c);
          for (const pos of group.stones) {
            checked[pos.row][pos.col] = true;
          }

          const size = group.stones.length;
          const libs = group.liberties;

          if (stone === myColor) {
            if (libs === 1) score -= 15000;
            else if (libs === 2) score += size * 10;
            else score += size * 20 + libs * 15;
          } else {
            if (libs === 1) score += 10000;
            else if (libs === 2) score += size * 30;
            else score -= size * 15;
          }
        }
      }
    }

    // Preemption Table: 2ターン後降臨予定の赤石による包囲脅威計算
    if (scheduledReds && scheduledReds.length > 0) {
      for (const red of scheduledReds) {
        const { b, c, owner } = red;
        const r = Math.floor(b / 3) * 3 + Math.floor(c / 3);
        const col = (b % 3) * 3 + (c % 3);
        const dirs = [[1, 0], [-1, 0], [0, 1], [0, -1]];

        for (const [dr, dc] of dirs) {
          const nr = r + dr, nc = col + dc;
          if (nr >= 0 && nr < 9 && nc >= 0 && nc < 9) {
            const adj = grid[nr][nc];
            if (owner === oppColor && adj === myColor) {
              score -= 250; // 敵赤石の隣接領域危険度
            } else if (owner === myColor && adj === oppColor) {
              score += 250; // 自陣赤石の封鎖効果
            }
          }
        }
      }
    }

    // ガスフェーズ直前の保護評価（空きマス10以下）
    if (emptyCount <= 12) {
      score += 50;
    }

    return score;
  }

  /**
   * 置換表（TT）付き Alpha-Beta 深層探索
   */
  function alphaBetaSearch(board, depth, alpha, beta, isMaximizing, myColor, scheduledReds, emptyCount) {
    const key = getBoardKey(board, isMaximizing ? myColor : (myColor === "white" ? "black" : "white"));
    if (TT.has(key)) {
      return TT.get(key);
    }

    if (depth === 0) {
      const val = evaluateBoardAdvanced(board, myColor, scheduledReds, emptyCount);
      TT.set(key, val);
      return val;
    }

    const currColor = isMaximizing ? myColor : (myColor === "white" ? "black" : "white");
    const oppColor = currColor === "white" ? "black" : "white";

    if (isMaximizing) {
      let maxEval = -Infinity;
      for (let b = 0; b < 9; b++) {
        for (let c = 0; c < 9; c++) {
          if (board[b][c] !== null) continue;
          const sim = simulatePlace(board, currColor, b, c);
          if (sim.legal) {
            const capturedOpp = sim.captured[oppColor] || 0;
            if (capturedOpp >= 15) return 999999;

            const evalVal = alphaBetaSearch(sim.board, depth - 1, alpha, beta, false, myColor, scheduledReds, emptyCount - 1);
            maxEval = Math.max(maxEval, evalVal);
            alpha = max(alpha, evalVal);
            if (beta <= alpha) break;
          }
        }
      }
      TT.set(key, maxEval);
      return maxEval;
    } else {
      let minEval = Infinity;
      for (let b = 0; b < 9; b++) {
        for (let c = 0; c < 9; c++) {
          if (board[b][c] !== null) continue;
          const sim = simulatePlace(board, currColor, b, c);
          if (sim.legal) {
            const capturedMy = sim.captured[myColor] || 0;
            if (capturedMy >= 15) return -999999;

            const evalVal = alphaBetaSearch(sim.board, depth - 1, alpha, beta, true, myColor, scheduledReds, emptyCount - 1);
            minEval = Math.min(minEval, evalVal);
            beta = Math.min(beta, evalVal);
            if (beta <= alpha) break;
          }
        }
      }
      TT.set(key, minEval);
      return minEval;
    }
  }

  // --- Engine Definition ---
  window.NTAI_Engine = {
    name: "Gemini_Alpha_v14_v2.7.2_Latest",
    author: "Google / Gemini",

    decideNextMove(board, gameState) {
      TT.clear(); // 毎ターン置換表クリア

      const myColor = gameState.player;
      const oppColor = myColor === "white" ? "black" : "white";
      const phase = gameState.phase || "place";
      const redStonesLeft = gameState.redStonesLeft !== undefined ? gameState.redStonesLeft : 5;
      const scheduledReds = gameState.scheduledRedStones || [];
      const emptyCount = gameState.emptyCount !== undefined ? gameState.emptyCount : 81;

      // 1. Setup Phase (Section 4)
      if (phase === "setup") {
        const mySetupBlocks = [];
        for (let b of CORNER_BLOCKS) {
          for (let c = 0; c < 9; c++) {
            if (board[b][c] === myColor) {
              mySetupBlocks.push(b);
              break;
            }
          }
        }

        for (let b of CORNER_BLOCKS) {
          if (mySetupBlocks.includes(b)) continue;
          for (let c = 0; c < 9; c++) {
            if (b === 2 && c === 4) continue; // B3-b2 回避
            if (board[b][c] === null) {
              return { place: { b, c, secretRed: false }, slide: null };
            }
          }
        }
      }

      // 2. Normal Placement Phase
      if (phase === "place") {
        let bestMove = null;
        let bestScore = -Infinity;

        for (let b = 0; b < 9; b++) {
          for (let c = 0; c < 9; c++) {
            if (board[b][c] !== null) continue;

            const sim = simulatePlace(board, myColor, b, c);
            if (sim.legal) {
              const oppCaptured = sim.captured[oppColor] || 0;
              const blueCaptured = sim.captured.blue || 0;

              if (oppCaptured >= 15) {
                return { place: { b, c, secretRed: false }, slide: null };
              }

              // 置換表＋Alpha-Beta探索による深層シミュレーション
              let score = alphaBetaSearch(sim.board, 2, -Infinity, Infinity, false, myColor, scheduledReds, emptyCount - 1);
              score += oppCaptured * 1000 + blueCaptured * 3000;

              if (score > bestScore) {
                bestScore = score;
                bestMove = { b, c, secretRed: false };
              }
            }

            // 戦術的秘匿壁（Preemption Red Stone）
            if (redStonesLeft > 0 && sim.legal && bestScore < 500) {
              let redScore = alphaBetaSearch(board, 1, -Infinity, Infinity, false, myColor, scheduledReds, emptyCount) + 400;
              if (redScore > bestScore) {
                bestScore = redScore;
                bestMove = { b, c, secretRed: true };
              }
            }
          }
        }

        if (bestMove) {
          return { place: bestMove, slide: null };
        }
      }

      // 3. Slide Phase
      if (phase === "slide") {
        let bestSlide = null;
        let bestSlideScore = -Infinity;

        for (let b = 0; b < 9; b++) {
          for (const dir of NT_DIRS) {
            const sim = slideBlock(board, b, dir);
            if (!sim) continue;

            const oppCaptured = sim.captured[oppColor] || 0;
            const blueCaptured = sim.captured.blue || 0;

            if (oppCaptured >= 15) {
              return { place: null, slide: { b, dir } };
            }

            let score = evaluateBoardAdvanced(sim.board, myColor, scheduledReds, emptyCount);
            score += oppCaptured * 1000 + blueCaptured * 3000;

            if (score > bestSlideScore) {
              bestSlideScore = score;
              bestSlide = { b, dir };
            }
          }
        }

        if (bestSlide) {
          return { place: null, slide: bestSlide };
        }

        return { place: null, slide: { pass: true } };
      }

      return { place: null, slide: { pass: true } };
    }
  };
})();
